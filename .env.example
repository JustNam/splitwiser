# Copy this file to `.env.local`, then fill in the two values.
#
# Where to find them: Supabase dashboard → your project → Project Settings →
# API. The URL is under "Project URL"; the key is the one labelled `anon`
# / `public`.
#
# `.env.local` is gitignored on purpose. This file (`.env.example`) is tracked
# so the next person knows which vars exist, without the values leaking.
#
# NOTE: env files load from the PROJECT ROOT, not from src/. Restart
# `npm run dev` after changing them — they are read once at startup.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
